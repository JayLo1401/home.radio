<?xml version="1.0" encoding="utf-8"?>
<!-- HomeButtonService: only window changes (which app is in front) - no
     window content, nothing typed. canRequestFilterKeyEvents: on Fire TV it
     catches the Home key itself (every other key passes untouched), see
     HomeButtonService.onKeyEvent. canPerformGestures: the Haussteuerung swipes a
     lock screen without PIN away when the display comes back (swipeAwayLockScreen). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:notificationTimeout="50"
    android:description="@string/home_button_service_description" />
