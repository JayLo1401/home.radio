<?xml version="1.0" encoding="utf-8"?>
<!-- Android's launch screen until Flutter's first frame: Home System's logo
     at the size the Flutter start screen (splash_screen.dart) shows it, so
     the hand-over doesn't jump. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />

    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/launch_logo" />
</layer-list>
