# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code session/tool metadata - not project source.
.claude/

# Scratch research/leftover files, not used by the app (the actual app icon
# lives at assets/icon/applogo1.png, which is tracked).
/applogo1.png
/applogo2.png
/applogo3.png
/pdf_text.txt

# Third-party reference APKs (decompiled locally for protocol comparison,
# 2026-09-16/17) and their extracted/decompiled contents - copyrighted
# binaries, not our source, not meant to be checked in.
/DAB-Z*.apk
/DABPlus-*/
/dabz_extracted/
